{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "views/**",
        "public/**",
        "database/**",
        "src/assets/**",
        "node_modules/sql.js/dist/**"
      ]
    }
  }
}
